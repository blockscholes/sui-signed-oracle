# Move
build/
**/build/

# Node / TS
node_modules/
dist/
*.tsbuildinfo

# env / secrets
.env
.env.*
!.env.example

# logs / local
*.log
.DS_Store

# local-only internal notes (open questions, references) — never committed
*.local.md

# transient localnet deployment ids (fresh chain id every regenesis).
# deployment.testnet.json is NOT ignored: it records a real deployment.
deployment.json

# Ephemeral addressing file `sui client test-publish --pubfile-path <name>` writes for
# local dev-loop iteration (fake dependency addresses). NOT the same as the per-package
# move/*/Published.toml that a real `sui client publish` writes automatically — that one
# holds real deployment data and is committed (see move/bs_oracle/Published.toml etc).
move/*/Pub.*.toml

# read-only reference clone (do not vendor)
reference/
