# Move
build/
**/build/

# Node / TS
node_modules/
dist/
*.tsbuildinfo

# env / secrets
.env
.env.*
!.env.example

# logs / local
*.log
.DS_Store

# local-only internal notes (open questions, references) — never committed
*.local.md

# transient localnet deployment ids
deployment.json

# Move publish metadata — the CLI's own `--pubfile-path` output (only ever ephemeral
# test-publish ids; `sui client publish` refuses --pubfile-path outright) always lands
# inside a package directory. Scoped to move/*/ so it can't shadow the hand-maintained,
# real-deployment published.toml at the repo root.
move/*/Published.toml
move/*/Pub.*.toml

# read-only reference clone (do not vendor)
reference/
